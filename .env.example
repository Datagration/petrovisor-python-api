# PetroVisor dev test credentials
# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit actual credentials.
#
# How to get TEST_KEY:
#   import petrovisor as pv
#   api = pv.PetroVisor(
#       workspace="Your Workspace",
#       discovery_url="https://identity.us1.petrovisor.com",
#       username="your@email.com",
#       password="yourpassword",
#   )
#   print(api.Key)   # paste the output below
#
# Keys expire periodically — regenerate when tests start failing with auth errors.

TEST_WORKSPACE=YourWorkspace
TEST_URL=https://identity.us1.petrovisor.com
TEST_KEY=your_api_key_here
